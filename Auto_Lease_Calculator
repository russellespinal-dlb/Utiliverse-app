<script>

/* =========================================================
   UTILITY FUNCTIONS
========================================================= */

function getNumber(id) {

    const value =
        parseFloat(
            document.getElementById(id).value
        );

    return isNaN(value)
        ? 0
        : value;
}


function money(value) {

    return new Intl.NumberFormat(
        "en-US",
        {
            style: "currency",
            currency: "USD",
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        }
    ).format(value);
}


/* =========================================================
   RATE TYPE CHANGE
========================================================= */

document
    .querySelectorAll(
        'input[name="rateType"]'
    )
    .forEach(function(radio) {

        radio.addEventListener(
            "change",
            function() {

                const rate =
                    getNumber("leaseRate");

                const helper =
                    document.getElementById(
                        "rateHelper"
                    );

                if (
                    this.value ===
                    "moneyfactor"
                ) {

                    helper.textContent =
                        "Example: 0.00208 is approximately 5.00% APR.";

                } else {

                    helper.textContent =
                        "Enter the annual percentage rate, such as 5.00.";

                }

            }
        );

    });


/* =========================================================
   MAIN CALCULATION
========================================================= */

function calculateLease() {


    /* -----------------------------------------------------
       INPUTS
    ----------------------------------------------------- */

    const vehiclePrice =
        getNumber("vehiclePrice");

    const leaseTerm =
        getNumber("leaseTerm");

    const residualValue =
        getNumber("residualValue");

    const downPayment =
        getNumber("downPayment");

    const tradeIn =
        getNumber("tradeIn");

    const salesTax =
        getNumber("salesTax");

    const rate =
        getNumber("leaseRate");


    const rateType =
        document.querySelector(
            'input[name="rateType"]:checked'
        ).value;



    /* -----------------------------------------------------
       VALIDATION
    ----------------------------------------------------- */

    if (vehiclePrice <= 0) {

        alert(
            "Please enter a valid vehicle price."
        );

        return;

    }


    if (leaseTerm <= 0) {

        alert(
            "Please enter a valid lease term."
        );

        return;

    }


    if (residualValue < 0) {

        alert(
            "Please enter a valid residual value."
        );

        return;

    }



    /* -----------------------------------------------------
       ADJUSTED CAPITALIZED COST
    -----------------------------------------------------

       Vehicle price
       minus down payment
       minus trade-in

    ----------------------------------------------------- */

    let adjustedCost =
        vehiclePrice -
        downPayment -
        tradeIn;


    if (adjustedCost < 0) {

        adjustedCost = 0;

    }



    /* -----------------------------------------------------
       MONEY FACTOR
    ----------------------------------------------------- */

    let moneyFactor = 0;

    let apr = 0;


    if (rateType === "moneyfactor") {

        moneyFactor =
            rate;

        apr =
            moneyFactor *
            2400;

    }

    else {

        apr =
            rate;

        moneyFactor =
            apr /
            2400;

    }



    /* -----------------------------------------------------
       DEPRECIATION
    ----------------------------------------------------- */

    let totalDepreciation =
        adjustedCost -
        residualValue;


    /*
       If the residual is greater than the adjusted cost,
       don't create a negative depreciation charge.
    */

    if (
        totalDepreciation < 0
    ) {

        totalDepreciation = 0;

    }


    const monthlyDepreciation =
        totalDepreciation /
        leaseTerm;



    /* -----------------------------------------------------
       MONTHLY FINANCE CHARGE
    -----------------------------------------------------

       Common lease calculation:

       (Adjusted Cost + Residual)
       × Money Factor

    ----------------------------------------------------- */

    const monthlyFinance =
        (
            adjustedCost +
            residualValue
        )
        *
        moneyFactor;



    /* -----------------------------------------------------
       MONTHLY TAX
    ----------------------------------------------------- */

    const monthlyTax =
        (
            monthlyDepreciation +
            monthlyFinance
        )
        *
        (
            salesTax / 100
        );



    /* -----------------------------------------------------
       MONTHLY PAYMENT
    ----------------------------------------------------- */

    const monthlyPayment =
        monthlyDepreciation +
        monthlyFinance +
        monthlyTax;



    /* -----------------------------------------------------
       TOTALS
    ----------------------------------------------------- */

    const totalPayments =
        monthlyPayment *
        leaseTerm;


    const upfrontContribution =
        downPayment +
        tradeIn;


    const totalLeaseCost =
        totalPayments +
        downPayment;



    /* -----------------------------------------------------
       UPDATE RESULTS
    ----------------------------------------------------- */

    document.getElementById(
        "monthlyPayment"
    ).textContent =
        money(monthlyPayment);


    document.getElementById(
        "monthlyDepreciation"
    ).textContent =
        money(monthlyDepreciation);


    document.getElementById(
        "monthlyFinance"
    ).textContent =
        money(monthlyFinance);


    document.getElementById(
        "monthlyTax"
    ).textContent =
        money(monthlyTax);


    document.getElementById(
        "adjustedCost"
    ).textContent =
        money(adjustedCost);


    document.getElementById(
        "resultResidual"
    ).textContent =
        money(residualValue);


    document.getElementById(
        "totalPayments"
    ).textContent =
        money(totalPayments);


    document.getElementById(
        "upfrontContribution"
    ).textContent =
        money(upfrontContribution);


    document.getElementById(
        "totalLeaseCost"
    ).textContent =
        money(totalLeaseCost);



    /* -----------------------------------------------------
       RATE CONVERSION
    ----------------------------------------------------- */

    document.getElementById(
        "rateConversion"
    ).textContent =

        rateType === "moneyfactor"

        ?

        "Money factor "
        + rate.toFixed(5)
        + " is approximately "
        + apr.toFixed(2)
        + "% APR."

        :

        "APR "
        + apr.toFixed(2)
        + "% corresponds to an estimated money factor of "
        + moneyFactor.toFixed(5)
        + ".";

}


/* =========================================================
   RESET
========================================================= */

function resetCalculator() {


    document.getElementById(
        "vehiclePrice"
    ).value =
        "50000";


    document.getElementById(
        "leaseTerm"
    ).value =
        "36";


    document.getElementById(
        "residualValue"
    ).value =
        "24000";


    document.getElementById(
        "downPayment"
    ).value =
        "10000";


    document.getElementById(
        "tradeIn"
    ).value =
        "0";


    document.getElementById(
        "salesTax"
    ).value =
        "7";


    document.getElementById(
        "leaseRate"
    ).value =
        "0.00208";


    document.getElementById(
        "moneyFactorOption"
    ).checked =
        true;


    calculateLease();

}


/* =========================================================
   FAQ ACCORDION
========================================================= */

function toggleFAQ(button) {


    const answer =
        button.nextElementSibling;


    const icon =
        button.querySelector(
            ".faq-icon"
        );


    const isOpen =
        answer.classList.contains(
            "open"
        );


    document
        .querySelectorAll(
            ".faq-answer"
        )
        .forEach(function(item) {

            item.classList.remove(
                "open"
            );

        });


    document
        .querySelectorAll(
            ".faq-icon"
        )
        .forEach(function(item) {

            item.textContent =
                "+";

        });


    if (!isOpen) {

        answer.classList.add(
            "open"
        );

        icon.textContent =
            "−";

    }

}


/* =========================================================
   INITIAL CALCULATION
========================================================= */

document.addEventListener(
    "DOMContentLoaded",
    function() {

        calculateLease();

    }
);

</script>


