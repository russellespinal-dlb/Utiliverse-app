   --------------------------------------------------------- */

function setLoanType(type) {

    currentLoan =
        type;


    document
        .querySelectorAll(
            ".loan-tab"
        )
        .forEach(
            function(tab) {

                tab.classList.toggle(
                    "active",
                    tab.dataset.loan === type
                );

            }
        );


    /*
       Adjust sensible DTI defaults.
    */

    if (type === "fha") {

        document.getElementById(
            "frontDTI"
        ).value = 31;

        document.getElementById(
            "backDTI"
        ).value = 43;

    }

    else if (type === "va") {

        document.getElementById(
            "frontDTI"
        ).value = 30;

        document.getElementById(
            "backDTI"
        ).value = 41;

    }

    else if (type === "usda") {

        document.getElementById(
            "frontDTI"
        ).value = 29;

        document.getElementById(
            "backDTI"
        ).value = 41;

    }

    else {

        document.getElementById(
            "frontDTI"
        ).value = 28;

        document.getElementById(
            "backDTI"
        ).value = 36;

    }


    calculate();

}


