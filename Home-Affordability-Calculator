<script>

/* =========================================================
   HOMEWISE CALCULATOR ENGINE
   ========================================================= */


/* ---------------------------------------------------------
   CURRENT LOAN TYPE
   --------------------------------------------------------- */

let currentLoan = "conventional";


/* ---------------------------------------------------------
   HELPER: GET NUMBER
   --------------------------------------------------------- */

function num(id) {

    const el = document.getElementById(id);

    if (!el) {
        return 0;
    }

    const value = parseFloat(el.value);

    return Number.isFinite(value)
        ? value
        : 0;
}


/* ---------------------------------------------------------
   MONEY FORMAT
   --------------------------------------------------------- */

function money(value) {

    if (!Number.isFinite(value)) {
        value = 0;
    }

    return value.toLocaleString(
        "en-US",
        {
            style: "currency",
            currency: "USD",
            maximumFractionDigits: 0
        }
    );
}


/* ---------------------------------------------------------
   MORTGAGE PAYMENT
   --------------------------------------------------------- */

function mortgagePayment(
    principal,
    annualRate,
    years
) {

    if (principal <= 0) {
        return 0;
    }

    const months =
        years * 12;

    const monthlyRate =
        annualRate / 100 / 12;


    if (monthlyRate === 0) {

        return principal / months;

    }


    return principal *
        (
            monthlyRate *
            Math.pow(
                1 + monthlyRate,
                months
            )
        ) /
        (
            Math.pow(
                1 + monthlyRate,
                months
            ) - 1
        );
}


/* ---------------------------------------------------------
   LOAN-SPECIFIC SETTINGS
   --------------------------------------------------------- */

function getLoanSettings() {

    if (currentLoan === "conventional") {

        return {

            minDown: .03,

            mortgageInsurance:
                "conventional"

        };

    }


    if (currentLoan === "fha") {

        return {

            minDown: .035,

            mortgageInsurance:
                "fha"

        };

    }


    if (currentLoan === "va") {

        return {

            minDown: 0,

            mortgageInsurance:
                "none"

        };

    }


    if (currentLoan === "usda") {

        return {

            minDown: 0,

            mortgageInsurance:
                "usda"

        };

    }

}


/* ---------------------------------------------------------
   CALCULATE HOUSING COST
   --------------------------------------------------------- */

function calculateHousing(
    homePrice,
    downPayment,
    rate,
    term,
    taxRate,
    insurance,
    hoa,
    maintenanceRate
) {

    const settings =
        getLoanSettings();


    /*
       Base loan
    */

    let baseLoan =
        Math.max(
            homePrice - downPayment,
            0
        );


    /*
       Some loan types may finance
       an upfront insurance/funding charge.
    */

    let financedFee = 0;


    if (currentLoan === "fha") {

        const upfrontRate =
            num("fhaUpfront") / 100;

        financedFee =
            baseLoan * upfrontRate;

    }


    if (currentLoan === "va") {

        const fundingRate =
            num("vaFunding") / 100;

        financedFee =
            baseLoan * fundingRate;

    }


    if (currentLoan === "usda") {

        const guaranteeRate =
            num("usdaGuarantee") / 100;

        financedFee =
            baseLoan * guaranteeRate;

    }


    const totalLoan =
        baseLoan + financedFee;


    /*
       Principal + interest
    */

    const principalInterest =
        mortgagePayment(
            totalLoan,
            rate,
            term
        );


    /*
       Property taxes
    */

    const monthlyTax =
        homePrice *
        (taxRate / 100) /
        12;


    /*
       Insurance
    */

    const monthlyInsurance =
        insurance / 12;


    /*
       HOA
    */

    const monthlyHOA =
        hoa;


    /*
       Maintenance
    */

    const monthlyMaintenance =
        homePrice *
        (maintenanceRate / 100) /
        12;


    /*
       Mortgage insurance
    */

    let monthlyMI = 0;


    /* Conventional PMI */

    if (
        currentLoan === "conventional" &&
        homePrice > 0 &&
        downPayment < homePrice * .20
    ) {

        monthlyMI =
            baseLoan *
            .005 /
            12;

    }


    /* FHA MIP */

    if (currentLoan === "fha") {

        const annual =
            num("fhaAnnual") / 100;

        monthlyMI =
            baseLoan *
            annual /
            12;

    }


    /* USDA annual fee estimate */

    if (currentLoan === "usda") {

        /*
           USDA guarantee fee is handled
           as an upfront estimate above.

           This additional factor is a
           simplified planning assumption.
        */

        monthlyMI =
            baseLoan *
            .0035 /
            12;

    }


    const total =
        principalInterest +
        monthlyTax +
        monthlyInsurance +
        monthlyHOA +
        monthlyMI +
        monthlyMaintenance;


    return {

        baseLoan,

        totalLoan,

        financedFee,

        principalInterest,

        monthlyTax,

        monthlyInsurance,

        monthlyHOA,

        monthlyMI,

        monthlyMaintenance,

        total

    };

}


/* ---------------------------------------------------------
   FIND MAX HOME PRICE
   --------------------------------------------------------- */

function findAffordablePrice() {

    const income =
        num("income");

    const debts =
        num("debts");

    const downPayment =
        num("downPayment");

    const rate =
        num("rate");

    const term =
        num("term");

    const taxRate =
        num("taxRate");

    const insurance =
        num("insurance");

    const hoa =
        num("hoa");

    const maintenanceRate =
        num("maintenanceRate");


    if (income <= 0) {

        return {

            price: 0,

            costs: null,

            dti: 0

        };

    }


    const monthlyIncome =
        income / 12;


    /*
       Housing limit
    */

    const housingLimit =
        monthlyIncome *
        (num("frontDTI") / 100);


    /*
       Total-debt limit
    */

    const totalLimit =
        monthlyIncome *
        (num("backDTI") / 100);


    const debtLimitedHousing =
        totalLimit - debts;


    /*
       Use the tighter constraint.
    */

    const allowedHousing =
        Math.min(
            housingLimit,
            debtLimitedHousing
        );


    if (allowedHousing <= 0) {

        return {

            price: 0,

            costs: null,

            dti: 0

        };

    }


    /*
       Binary search for maximum price.
    */

    let low = 0;

    let high =
        Math.max(
            income * 12,
            downPayment + 100000
        );


    for (
        let i = 0;
        i < 100;
        i++
    ) {

        const middle =
            (low + high) / 2;


        const costs =
            calculateHousing(
                middle,
                Math.min(
                    downPayment,
                    middle
                ),
                rate,
                term,
                taxRate,
                insurance,
                hoa,
                maintenanceRate
            );


        if (
            costs.total <=
            allowedHousing
        ) {

            low =
                middle;

        } else {

            high =
                middle;

        }

    }


    const price =
        low;


    const actualDown =
        Math.min(
            downPayment,
            price
        );


    const costs =
        calculateHousing(
            price,
            actualDown,
            rate,
            term,
            taxRate,
            insurance,
            hoa,
            maintenanceRate
        );


    const totalDTI =
        (
            costs.total +
            debts
        ) /
        monthlyIncome *
        100;


    return {

        price,

        costs,

        dti:
            totalDTI

    };

}


/* ---------------------------------------------------------
   UPDATE DTI DISPLAY
   --------------------------------------------------------- */

function updateDTI(dti) {

    const value =
        document.getElementById(
            "dtiValue"
        );

    const fill =
        document.getElementById(
            "dtiFill"
        );

    const message =
        document.getElementById(
            "dtiMessage"
        );


    value.textContent =
        dti.toFixed(1) +
        "%";


    /*
       Cap visual width at 60%.
    */

    const width =
        Math.min(
            dti / 60 * 100,
            100
        );


    fill.style.width =
        width + "%";


    if (dti <= 30) {

        fill.style.background =
            "#159570";

        message.textContent =
            "Conservative debt level based on this estimate.";

    }

    else if (dti <= 36) {

        fill.style.background =
            "#159570";

        message.textContent =
            "Within a commonly used conservative planning range.";

    }

    else if (dti <= 43) {

        fill.style.background =
            "#ed8b2f";

        message.textContent =
            "Higher debt burden. Review your full monthly budget carefully.";

    }

    else {

        fill.style.background =
            "#d64545";

        message.textContent =
            "High debt burden. Actual lender requirements may differ.";

    }

}


/* ---------------------------------------------------------
   UPDATE PAYMENT BAR
   --------------------------------------------------------- */

function updatePaymentBar(costs) {

    if (!costs) {
        return;
    }


    const total =
        costs.total || 1;


    const items = [

        ["barPI", costs.principalInterest],

        ["barTax", costs.monthlyTax],

        ["barInsurance", costs.monthlyInsurance],

        ["barHOA", costs.monthlyHOA],

        ["barMI", costs.monthlyMI],

        ["barMaintenance", costs.monthlyMaintenance]

    ];


    items.forEach(
        function(item) {

            const element =
                document.getElementById(
                    item[0]
                );

            const amount =
                item[1];


            element.style.width =
                Math.max(
                    0,
                    amount / total * 100
                ) + "%";

        }
    );

}


/* ---------------------------------------------------------
   UPDATE MAIN RESULT
   --------------------------------------------------------- */

function updateMainResult(result) {

    const price =
        result.price;


    if (!result.costs) {

        document.getElementById(
            "maxPrice"
        ).textContent =
            "$0";

        return;

    }


    const costs =
        result.costs;


    const down =
        Math.min(
            num("downPayment"),
            price
        );


    const closingCosts =
        price *
        (num("closingRate") / 100);


    const cashReserve =
        num("cashReserve");


    const cashToClose =
        down +
        closingCosts +
        cashReserve;


    const comfortable =
        price * .85;


    /*
       Main numbers
    */

    document.getElementById(
        "maxPrice"
    ).textContent =
        money(price);


    document.getElementById(
        "comfortablePrice"
    ).textContent =
        money(comfortable);


    document.getElementById(
        "maxRangePrice"
    ).textContent =
        money(price);


    document.getElementById(
        "loanAmount"
    ).textContent =
        money(costs.totalLoan);


    document.getElementById(
        "downResult"
    ).textContent =
        money(down);


    document.getElementById(
        "monthlyHousing"
    ).textContent =
        money(costs.total);


    document.getElementById(
        "cashToClose"
    ).textContent =
        money(cashToClose);


    /*
       Description
    */

    document.getElementById(
        "resultDescription"
    ).textContent =
        "Estimated from your income, existing debt, loan assumptions and selected housing-cost limits.";


    /*
       DTI
    */

    updateDTI(
        result.dti
    );


    /*
       Payment breakdown
    */

    document.getElementById(
        "piResult"
    ).textContent =
        money(costs.principalInterest);


    document.getElementById(
        "taxResult"
    ).textContent =
        money(costs.monthlyTax);


    document.getElementById(
        "insuranceResult"
    ).textContent =
        money(costs.monthlyInsurance);


    document.getElementById(
        "hoaResult"
    ).textContent =
        money(costs.monthlyHOA);


    document.getElementById(
        "miResult"
    ).textContent =
        money(costs.monthlyMI);


    document.getElementById(
        "maintenanceResult"
    ).textContent =
        money(costs.monthlyMaintenance);


    document.getElementById(
        "totalResult"
    ).textContent =
        money(costs.total);


    updatePaymentBar(
        costs
    );

}


/* ---------------------------------------------------------
   MAIN CALCULATION
   --------------------------------------------------------- */

function calculate() {

    const result =
        findAffordablePrice();


    updateMainResult(
        result
    );

}


