<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Utiliverse — Home Affordability Calculator</title>

<meta
    name="description"
    content="Estimate your home buying budget using income, debts, mortgage rates, taxes, insurance, down payment and loan type."
>

<style>

/* =========================================================
   Utiliverse
   ORIGINAL HOME AFFORDABILITY CALCULATOR
   No external libraries required
   ========================================================= */


/* ---------------------------------------------------------
   ROOT VARIABLES
   --------------------------------------------------------- */

:root {

    --navy: #102a43;
    --navy-2: #173f5f;

    --blue: #1976d2;
    --blue-dark: #125ca5;
    --blue-light: #eaf4ff;

    --green: #159570;
    --green-light: #eafaf5;

    --orange: #ed8b2f;
    --orange-light: #fff5e9;

    --red: #d64545;
    --red-light: #fff0f0;

    --purple: #7657d9;
    --purple-light: #f3efff;

    --text: #263746;
    --muted: #718096;

    --background: #f5f7fa;
    --white: #ffffff;

    --border: #dce4ec;
    --border-dark: #c5d0da;

    --shadow:
        0 12px 35px rgba(16,42,67,.08);

    --radius: 16px;
}


/* ---------------------------------------------------------
   GLOBAL
   --------------------------------------------------------- */

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {

    margin: 0;

    background: var(--background);

    color: var(--text);

    font-family:
        Inter,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Arial,
        sans-serif;

    line-height: 1.5;
}

button,
input,
select {
    font-family: inherit;
}

button {
    cursor: pointer;
}


/* ---------------------------------------------------------
   HEADER
   --------------------------------------------------------- */

.topbar {

    background:
        linear-gradient(
            135deg,
            #102a43,
            #174c73
        );

    color: white;
}

.topbar-inner {

    max-width: 1180px;

    margin: auto;

    min-height: 68px;

    padding:
        0 22px;

    display: flex;

    align-items: center;

    justify-content: space-between;
}

.logo {

    font-size: 22px;

    font-weight: 800;

    letter-spacing: -.5px;
}

.logo span {
    color: #5dd6b2;
}

.topbar-tag {

    font-size: 13px;

    color: #cfe3f1;
}


/* ---------------------------------------------------------
   PAGE
   --------------------------------------------------------- */

.container {

    width: min(1180px, calc(100% - 32px));

    margin: auto;

    padding:
        28px 0 70px;
}


/* ---------------------------------------------------------
   HERO
   --------------------------------------------------------- */

.hero {

    background:
        linear-gradient(
            135deg,
            #ffffff,
            #eef7ff
        );

    border:
        1px solid var(--border);

    border-radius:
        var(--radius);

    padding:
        34px;

    margin-bottom:
        22px;

    box-shadow:
        var(--shadow);
}

.hero-grid {

    display:
        grid;

    grid-template-columns:
        1.25fr .75fr;

    gap:
        35px;

    align-items:
        center;
}

.hero h1 {

    margin:
        0 0 10px;

    color:
        var(--navy);

    font-size:
        clamp(30px, 4vw, 46px);

    line-height:
        1.08;

    letter-spacing:
        -1.5px;
}

.hero p {

    margin:
        0;

    max-width:
        680px;

    color:
        #526678;

    font-size:
        16px;
}

.hero-badge {

    background:
        white;

    border:
        1px solid var(--border);

    border-radius:
        14px;

    padding:
        20px;

    box-shadow:
        0 6px 20px rgba(16,42,67,.05);
}

.hero-badge-title {

    font-size:
        12px;

    font-weight:
        800;

    color:
        var(--muted);

    text-transform:
        uppercase;

    letter-spacing:
        .8px;
}

.hero-badge-value {

    font-size:
        28px;

    font-weight:
        800;

    color:
        var(--blue);

    margin-top:
        5px;
}

.hero-badge-text {

    font-size:
        12px;

    color:
        var(--muted);
}


/* ---------------------------------------------------------
   CALCULATOR CARD
   --------------------------------------------------------- */

.card {

    background:
        var(--white);

    border:
        1px solid var(--border);

    border-radius:
        var(--radius);

    box-shadow:
        var(--shadow);

    margin-bottom:
        22px;

    overflow:
        hidden;
}

.card-header {

    padding:
        23px 27px;

    border-bottom:
        1px solid var(--border);

    display:
        flex;

    justify-content:
        space-between;

    align-items:
        center;

    gap:
        20px;
}

.card-header h2 {

    margin:
        0 0 4px;

    color:
        var(--navy);

    font-size:
        21px;
}

.card-header p {

    margin:
        0;

    font-size:
        13px;

    color:
        var(--muted);
}

.card-body {
    padding:
        27px;
}


/* ---------------------------------------------------------
   LOAN TYPE TABS
   --------------------------------------------------------- */

.loan-tabs {

    display:
        grid;

    grid-template-columns:
        repeat(4, 1fr);

    gap:
        9px;

    margin-bottom:
        26px;
}

.loan-tab {

    border:
        1px solid var(--border);

    background:
        #fafbfd;

    border-radius:
        11px;

    padding:
        13px 8px;

    text-align:
        center;

    color:
        var(--text);

    font-weight:
        700;

    transition:
        .18s ease;
}

.loan-tab:hover {

    border-color:
        #a9c8e1;

    transform:
        translateY(-1px);
}

.loan-tab.active {

    color:
        white;

    background:
        var(--blue);

    border-color:
        var(--blue);

    box-shadow:
        0 5px 15px rgba(25,118,210,.22);
}

.loan-tab small {

    display:
        block;

    font-size:
        10px;

    margin-top:
        2px;

    opacity:
        .75;

    font-weight:
        500;
}


/* ---------------------------------------------------------
   FORM
   --------------------------------------------------------- */

.form-grid {

    display:
        grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap:
        20px;
}

.field {

    display:
        flex;

    flex-direction:
        column;
}

.field.full {
    grid-column:
        1 / -1;
}

.field label {

    font-size:
        13px;

    font-weight:
        750;

    margin-bottom:
        7px;

    color:
        #34495a;
}

.field-help {

    margin-top:
        5px;

    color:
        var(--muted);

    font-size:
        11px;
}

.input-wrap {
    position:
        relative;
}

.input-prefix,
.input-suffix {

    position:
        absolute;

    top:
        50%;

    transform:
        translateY(-50%);

    color:
        var(--muted);

    font-size:
        14px;

    pointer-events:
        none;
}

.input-prefix {
    left:
        12px;
}

.input-suffix {
    right:
        12px;
}

.input-prefix + input {
    padding-left:
        29px;
}

.input-suffix-wrap input {
    padding-right:
        40px;
}

input,
select {

    width:
        100%;

    height:
        45px;

    border:
        1px solid var(--border-dark);

    border-radius:
        9px;

    background:
        white;

    padding:
        10px 12px;

    color:
        var(--text);

    font-size:
        14px;

    outline:
        none;

    transition:
        .15s;
}

input:focus,
select:focus {

    border-color:
        var(--blue);

    box-shadow:
        0 0 0 3px rgba(25,118,210,.10);
}


/* ---------------------------------------------------------
   SLIDER
   --------------------------------------------------------- */

.slider-line {

    display:
        grid;

    grid-template-columns:
        1fr 110px;

    gap:
        12px;

    align-items:
        center;
}

input[type="range"] {

    height:
        auto;

    padding:
        0;

    border:
        0;

    box-shadow:
        none;

    accent-color:
        var(--blue);
}


/* ---------------------------------------------------------
   ADVANCED OPTIONS
   --------------------------------------------------------- */

.advanced-toggle {

    margin-top:
        23px;

    border:
        1px solid var(--border);

    border-radius:
        10px;

    overflow:
        hidden;
}

.advanced-head {

    padding:
        14px 16px;

    background:
        #f8fafc;

    cursor:
        pointer;

    font-size:
        13px;

    font-weight:
        800;

    display:
        flex;

    justify-content:
        space-between;
}

.advanced-content {

    padding:
        18px;

    display:
        none;
}

.advanced-content.open {
    display:
        block;
}


/* ---------------------------------------------------------
   BUTTONS
   --------------------------------------------------------- */

.actions {

    display:
        flex;

    gap:
        10px;

    margin-top:
        25px;

    flex-wrap:
        wrap;
}

.btn {

    border:
        0;

    border-radius:
        9px;

    min-height:
        44px;

    padding:
        10px 19px;

    font-size:
        14px;

    font-weight:
        800;

    transition:
        .16s;
}

.btn-primary {

    background:
        var(--blue);

    color:
        white;
}

.btn-primary:hover {
    background:
        var(--blue-dark);
}

.btn-secondary {

    background:
        #edf1f5;

    color:
        var(--text);
}

.btn-secondary:hover {
    background:
        #dfe6ed;
}

.btn-outline {

    background:
        white;

    color:
        var(--blue);

    border:
        1px solid #aac9e4;
}


/* ---------------------------------------------------------
   RESULT AREA
   --------------------------------------------------------- */

.results {

    margin-top:
        28px;

    display:
        grid;

    grid-template-columns:
        1fr 1fr;

    gap:
        17px;
}

.result-hero {

    border-radius:
        15px;

    padding:
        25px;

    background:
        linear-gradient(
            145deg,
            #102a43,
            #1b5279
        );

    color:
        white;

    position:
        relative;

    overflow:
        hidden;
}

.result-hero::after {

    content:
        "";

    position:
        absolute;

    width:
        190px;

    height:
        190px;

    border-radius:
        50%;

    border:
        25px solid rgba(255,255,255,.06);

    right:
        -70px;

    top:
        -80px;
}

.result-kicker {

    font-size:
        11px;

    text-transform:
        uppercase;

    letter-spacing:
        1px;

    color:
        #b8d8ea;

    font-weight:
        800;
}

.result-price {

    font-size:
        clamp(34px, 5vw, 48px);

    font-weight:
        900;

    letter-spacing:
        -1px;

    margin:
        4px 0 7px;
}

.result-description {

    color:
        #d6e8f2;

    font-size:
        12px;

    max-width:
        480px;
}

.result-actions {

    margin-top:
        20px;

    display:
        flex;

    gap:
        8px;

    flex-wrap:
        wrap;
}

.result-actions .btn {

    background:
        rgba(255,255,255,.11);

    color:
        white;

    border:
        1px solid rgba(255,255,255,.22);
}


/* ---------------------------------------------------------
   RESULT STATS
   --------------------------------------------------------- */

.stat-grid {

    display:
        grid;

    grid-template-columns:
        repeat(2, 1fr);

    gap:
        12px;
}

.stat {

    border:
        1px solid var(--border);

    border-radius:
        12px;

    padding:
        15px;

    background:
        #fff;
}

.stat-label {

    font-size:
        11px;

    color:
        var(--muted);

    text-transform:
        uppercase;

    letter-spacing:
        .35px;
}

.stat-value {

    margin-top:
        3px;

    font-size:
        20px;

    font-weight:
        850;

    color:
        var(--navy);
}


/* ---------------------------------------------------------
   DTI INDICATOR
   --------------------------------------------------------- */

.dti-box {

    margin-top:
        14px;

    border:
        1px solid var(--border);

    border-radius:
        12px;

    padding:
        15px;
}

.dti-header {

    display:
        flex;

    justify-content:
        space-between;

    align-items:
        center;

    margin-bottom:
        9px;
}

.dti-title {

    font-size:
        12px;

    font-weight:
        800;
}

.dti-value {

    font-size:
        18px;

    font-weight:
        900;
}

.dti-track {

    height:
        10px;

    background:
        #edf1f5;

    border-radius:
        20px;

    overflow:
        hidden;
}

.dti-fill {

    height:
        100%;

    width:
        0%;

    background:
        var(--green);

    border-radius:
        inherit;

    transition:
        width .5s ease,
        background .3s ease;
}

.dti-message {

    margin-top:
        7px;

    font-size:
        11px;

    color:
        var(--muted);
}


/* ---------------------------------------------------------
   PAYMENT BREAKDOWN
   --------------------------------------------------------- */

.breakdown {

    margin-top:
        18px;

    border:
        1px solid var(--border);

    border-radius:
        14px;

    overflow:
        hidden;
}

.breakdown-header {

    padding:
        16px 18px;

    background:
        #f8fafc;

    border-bottom:
        1px solid var(--border);

    font-weight:
        800;

    font-size:
        14px;
}

.breakdown-row {

    display:
        flex;

    justify-content:
        space-between;

    align-items:
        center;

    padding:
        11px 18px;

    border-bottom:
        1px solid #edf1f4;

    font-size:
        13px;
}

.breakdown-row:last-child {

    border-bottom:
        0;

    background:
        #fbfcfd;

    font-weight:
        850;
}

.breakdown-name {

    display:
        flex;

    align-items:
        center;

    gap:
        9px;
}

.dot {

    width:
        9px;

    height:
        9px;

    border-radius:
        50%;

    background:
        var(--blue);
}

.dot.green {
    background:
        var(--green);
}

.dot.orange {
    background:
        var(--orange);
}

.dot.purple {
    background:
        var(--purple);
}

.dot.red {
    background:
        var(--red);
}


/* ---------------------------------------------------------
   PAYMENT BAR
   --------------------------------------------------------- */

.payment-bar {

    display:
        flex;

    height:
        14px;

    margin:
        17px 18px 5px;

    border-radius:
        20px;

    overflow:
        hidden;

    background:
        #edf1f5;
}

.payment-segment {
    transition:
        width .5s ease;
}


/* ---------------------------------------------------------
   RANGE COMPARISON
   --------------------------------------------------------- */

.range-card {

    margin-top:
        18px;

    padding:
        17px;

    border:
        1px solid var(--border);

    border-radius:
        13px;

    background:
        #fff;
}

.range-title {

    font-size:
        13px;

    font-weight:
        800;

    margin-bottom:
        12px;
}

.range-values {

    display:
        flex;

    justify-content:
        space-between;

    gap:
        15px;
}

.range-value strong {

    display:
        block;

    font-size:
        20px;

    color:
        var(--navy);
}

.range-value span {

    font-size:
        11px;

    color:
        var(--muted);
}


/* ---------------------------------------------------------
   MONTHLY BUDGET SECTION
   --------------------------------------------------------- */

.budget-card {

    background:
        linear-gradient(
            145deg,
            #ffffff,
            #f3faf8
        );
}


/* ---------------------------------------------------------
   INFO SECTION
   --------------------------------------------------------- */

.info-grid {

    display:
        grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap:
        14px;
}

.info-tile {

    padding:
        18px;

    border:
        1px solid var(--border);

    border-radius:
        13px;

    background:
        white;
}

.info-icon {

    width:
        35px;

    height:
        35px;

    border-radius:
        10px;

    background:
        var(--blue-light);

    color:
        var(--blue);

    display:
        flex;

    align-items:
        center;

    justify-content:
        center;

    font-weight:
        900;

    margin-bottom:
        10px;
}

.info-tile h3 {

    margin:
        0 0 5px;

    font-size:
        14px;

    color:
        var(--navy);
}

.info-tile p {

    margin:
        0;

    color:
        var(--muted);

    font-size:
        12px;
}


/* ---------------------------------------------------------
   NOTICE
   --------------------------------------------------------- */

.notice {

    margin-top:
        20px;

    padding:
        15px 17px;

    background:
        var(--orange-light);

    border:
        1px solid #f4d39d;

    border-radius:
        10px;

    font-size:
        12px;

    color:
        #755000;
}


/* ---------------------------------------------------------
   FOOTER
   --------------------------------------------------------- */

footer {

    max-width:
        1180px;

    margin:
        auto;

    padding:
        0 22px 40px;

    text-align:
        center;

    color:
        var(--muted);

    font-size:
        11px;
}


/* ---------------------------------------------------------
   PRINT
   --------------------------------------------------------- */

@media print {

    .topbar,
    .hero,
    .actions,
    .result-actions,
    .loan-tabs,
    .advanced-toggle,
    footer {
        display:
            none !important;
    }

    body {
        background:
            white;
    }

    .container {
        width:
            100%;
    }

    .card {
        box-shadow:
            none;

        border:
            1px solid #bbb;
    }

}


/* ---------------------------------------------------------
   RESPONSIVE
   --------------------------------------------------------- */

@media (max-width: 900px) {

    .hero-grid {
        grid-template-columns:
            1fr;
    }

    .form-grid {
        grid-template-columns:
            repeat(2, 1fr);
    }

    .results {
        grid-template-columns:
            1fr;
    }

    .info-grid {
        grid-template-columns:
            1fr 1fr;
    }

}

@media (max-width: 620px) {

    .container {
        width:
            min(100% - 20px, 1180px);
    }

    .hero {
        padding:
            24px;
    }

    .card-body {
        padding:
            20px;
    }

    .card-header {
        padding:
            19px;
    }

    .loan-tabs {
        grid-template-columns:
            repeat(2, 1fr);
    }

    .form-grid {
        grid-template-columns:
            1fr;
    }

    .field.full {
        grid-column:
            auto;
    }

    .info-grid {
        grid-template-columns:
            1fr;
    }

    .stat-grid {
        grid-template-columns:
            1fr 1fr;
    }

    .topbar-tag {
        display:
            none;
    }

}

@media (max-width: 420px) {

    .stat-grid {
        grid-template-columns:
            1fr;
    }

    .range-values {
        flex-direction:
            column;
    }

}

</style>
</head>


<body>


<!-- =========================================================
     HEADER
     ========================================================= -->

<header class="topbar">

    <div class="topbar-inner">

        <div class="logo">
            Home<span>Wise</span>
        </div>

        <div class="topbar-tag">
            Smarter home-buying estimates
        </div>

    </div>

</header>



<main class="container">


<!-- =========================================================
     HERO
     ========================================================= -->

<section class="hero">

    <div class="hero-grid">

        <div>

            <h1>
                Find a home price that fits your numbers.
            </h1>

            <p>
                Explore your estimated buying range using your income,
                existing debt, down payment, mortgage rate and the real
                monthly costs that come with owning a home.
            </p>

        </div>


        <div class="hero-badge">

            <div class="hero-badge-title">
                Planning principle
            </div>

            <div class="hero-badge-value">
                Payment ≠ Mortgage
            </div>

            <div class="hero-badge-text">
                Taxes, insurance, HOA fees and mortgage insurance can
                materially change the payment you can actually afford.
            </div>

        </div>

    </div>

</section>



<!-- =========================================================
     MAIN CALCULATOR
     ========================================================= -->

<section class="card">

    <div class="card-header">

        <div>

            <h2>
                Home affordability planner
            </h2>

            <p>
                Adjust the assumptions below to build your estimated
                maximum purchase price.
            </p>

        </div>

    </div>


    <div class="card-body">


        <!-- LOAN TYPE -->

        <div class="loan-tabs">

            <button
                class="loan-tab active"
                data-loan="conventional"
                onclick="setLoanType('conventional')"
            >
                Conventional
                <small>Typical conventional financing</small>
            </button>


            <button
                class="loan-tab"
                data-loan="fha"
                onclick="setLoanType('fha')"
            >
                FHA
                <small>Government-insured option</small>
            </button>


            <button
                class="loan-tab"
                data-loan="va"
                onclick="setLoanType('va')"
            >
                VA
                <small>Eligible borrowers</small>
            </button>


            <button
                class="loan-tab"
                data-loan="usda"
                onclick="setLoanType('usda')"
            >
                USDA
                <small>Eligible rural properties</small>
            </button>

        </div>



        <!-- FORM -->

        <div class="form-grid">


            <!-- INCOME -->

            <div class="field">

                <label for="income">
                    Annual gross income
                </label>

                <div class="input-wrap">

                    <span class="input-prefix">$</span>

                    <input
                        id="income"
                        type="number"
                        min="0"
                        value="90000"
                        oninput="syncAndCalculate()"
                    >

                </div>

                <div class="field-help">
                    Income before taxes and deductions.
                </div>

            </div>



            <!-- DEBT -->

            <div class="field">

                <label for="debts">
                    Monthly recurring debt
                </label>

                <div class="input-wrap">

                    <span class="input-prefix">$</span>

                    <input
                        id="debts"
                        type="number"
                        min="0"
                        value="500"
                        oninput="syncAndCalculate()"
                    >

                </div>

