/* ---------------------------------------------------------
   MONTHLY BUDGET CALCULATOR
   --------------------------------------------------------- */

function calculateBudget() {

    const budget =
        num("budget");

    const down =
        num("budgetDown");

    const rate =
        num("budgetRate");

    const term =
        num("budgetTerm");

    const taxRate =
        num("budgetTax");

    const insurance =
        num("budgetInsurance");

    const hoa =
        num("budgetHOA");

    const maintenanceRate =
        num("budgetMaintenance");


    if (budget <= 0) {

        return;

    }


    let low = 0;

    let high = 2000000;


    for (
        let i = 0;
        i < 100;
        i++
    ) {

        const middle =
            (low + high) / 2;


        const costs =
            calculateHousing(
                middle,
                Math.min(
                    down,
                    middle
                ),
                rate,
                term,
                taxRate,
                insurance,
                hoa,
                maintenanceRate
            );


        if (
            costs.total <=
            budget
        ) {

            low =
                middle;

        } else {

            high =
                middle;

        }

    }


    const price =
        low;


    const actualDown =
        Math.min(
            down,
            price
        );


    const costs =
        calculateHousing(
            price,
            actualDown,
            rate,
            term,
            taxRate,
            insurance,
            hoa,
            maintenanceRate
        );


    document.getElementById(
        "budgetPrice"
    ).textContent =
        money(price);


    document.getElementById(
        "budgetLoanResult"
    ).textContent =
        money(costs.totalLoan);


    document.getElementById(
        "budgetDownResult"
    ).textContent =
        money(actualDown);


    document.getElementById(
        "budgetMonthlyResult"
    ).textContent =
        money(costs.total);


    document.getElementById(
        "budgetMIResult"
    ).textContent =
        money(costs.monthlyMI);

}


